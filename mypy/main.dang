pub description = "Static type checking for Python projects, powered by mypy"

"""
mypy over every Python project in a workspace.

mypy runs inside the project's environment on purpose. Without the installed
packages it cannot resolve third-party imports and reports errors that are not
real, and a false error is worse than no check at all.

The version is resolved from what the project pins rather than from whatever
shipped this morning. See `github.com/dagger/python/ty` for Astral's checker.

https://dagger.io
https://mypy-lang.org
"""
type Mypy {
  """
  Files whose presence makes a directory a project mypy should check.
  """
  let markers: [String!]! = ["pyproject.toml"]

  """
  Python version used for the default base image. Null when a custom base is set.
  """
  version: String {
    lib.version
  }

  """
  Project roots to check ("!" excludes; see the `scope` constructor argument).
  """
  scope: [String!]! = ["**"]

  """
  mypy version used for a project that pins none of its own.

  Pinned rather than floating: `uv run --with mypy` resolves to whichever mypy
  is newest on the day it runs, so a check starts failing on a day nobody
  touched any code.
  """
  defaultVersion: String! = "2.3.1"

  let pythonVersion: String
  let base: Container

  new(
    """
    Python version used for the default base image. Mutually exclusive with base.
    """
    version: String = null,
    """
    Base image for every mypy container. Expected to provide a Python
    interpreter and uv on PATH. Mutually exclusive with version.
    """
    base: Container = null,
    """
    Project roots to check. A bare pattern selects, a "!"-prefixed pattern
    excludes, and an exclude always wins whatever the order, so ["**", "!docs"]
    checks everything but docs.
    """
    scope: [String!]! = ["**"],
    """
    mypy version used for a project that pins none of its own.
    """
    defaultVersion: String! = "2.3.1",
  ) {
    self.pythonVersion = version
    self.base = base
    self.scope = scope
    self.defaultVersion = defaultVersion
    self
  }

  let lib: Pyproject! {
    pyproject(markers: markers, version: pythonVersion, base: base)
  }

  """
  Python projects at or below the working directory that hold Python source of
  their own, keyed by project root.
  """
  projects(ws: Workspace!, includeSkipped: Boolean! = true): MypyProjects! {
    MypyProjects(
      paths: lib
        .rootsWithinCwd(ws)
        .map { root => mypyProject(root) }.{{path, skip, sources: hasSources(ws)}}
        .filter { project => project.sources and (includeSkipped or project.skip == false) }
        .map { project => project.path },
      tool: self,
    )
  }

  """
  The mypy project containing a workspace path.
  """
  project(ws: Workspace!, path: String!, findUp: Boolean! = true): MypyProject! {
    mypyProject(lib.project(ws, path, findUp: findUp).path)
  }

  let mypyProject(root: String!): MypyProject! {
    MypyProject(path: root, tool: self)
  }

  """
  The mypy version used for a project: what it pins, else the default.
  """
  versionFor(ws: Workspace!, path: String!): String! {
    lib.project(ws, path).toolVersion(ws, "mypy") ?? defaultVersion
  }
}

# Keep all Dang types in one source file until Dagger can convert Workspace
# arguments for installed multi-file Dang modules. See dagger/dagger#13476.

"""
Python projects in a workspace, keyed by project root.
"""
type MypyProjects @collection {
  """
  Project root paths.
  """
  paths: [String!]! @keys

  let tool: Mypy!

  """
  The mypy project rooted at path.
  """
  project(path: String!): MypyProject! @get {
    tool.mypyProject(path)
  }

  """
  Type check the selected projects with mypy.
  """
  typeCheck(ws: Workspace!): Void @check {
    # A selection over a list evaluates its elements concurrently, so every
    # project is checked in parallel and every failure is reported.
    let failures = paths.map { p => project(p) }.{{path, failure: typeCheckFailure(ws)}}
      .filter { result => result.failure != null }
    if (failures.length > 0) {
      raise "mypy type check failed:\n" + failures.map { result =>
        "- " + result.path + ": " + (result.failure ?? "")
      }.join("\n")
    }
    null
  }
}

"""
A Python project rooted at a workspace-relative path.
"""
type MypyProject {
  """
  Project root, relative to the workspace.
  """
  path: String!

  let tool: Mypy!

  """
  Whether this project is outside the configured scope.
  """
  skip: Boolean! {
    tool.lib.at(path).selected(tool.scope) == false
  }

  """
  Whether this project holds Python source of its own, rather than only in a
  project nested inside it.
  """
  hasSources(ws: Workspace!): Boolean! {
    tool.lib.at(path).hasOwnFiles(ws, ["**/*.py"])
  }

  """
  The mypy version this project is checked with: what it pins, else the
  module default.
  """
  version(ws: Workspace!): String! {
    tool.lib.at(path).toolVersion(ws, "mypy") ?? tool.defaultVersion
  }

  """
  Type check this project with mypy.
  """
  typeCheck(ws: Workspace!): Void @check {
    let failure = typeCheckFailure(ws)
    if (failure != null) {
      raise "mypy type check failed in " + path + ": " + failure
    }
    null
  }

  """
  Error message from type checking this project, or null when it passes, is
  outside the configured scope, or holds no Python source of its own.
  """
  let typeCheckFailure(ws: Workspace!): String {
    if (skip or hasSources(ws) == false) {
      null
    } else {
      { typeCheckExec(ws).sync; null } rescue {
        err: Error => err.message
      }
    }
  }

  let typeCheckExec(ws: Workspace!): Container! {
    let project = tool.lib.at(path)
    let packages = ["mypy==" + version(ws)]
    # The environment comes from the library, so the `uv sync` layer underneath
    # is the same one pytest and the other checker get.
    project
      .env(ws, with: packages)
      .withExec(["uv", "run"] + project.withFlags(packages) + ["mypy", "."]
        + project.excludeNestedFlags(ws, "--exclude", regex: true))
  }
}
