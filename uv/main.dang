pub description = "Dependency locking, packaging and auditing for Python projects, powered by uv"

"""
uv over every Python project in a workspace.

Locking is a generate rather than a pass/fail check: drift then shows up in
`dagger check`, as the lock's staleness check, and is repaired by
`dagger generate`, which is strictly more useful than a check that only says
the lockfile is stale.

Packaging is not a check at all. An application-only project and a non-packaged
uv workspace member have no build backend, and failing those would be wrong.

https://dagger.io
https://docs.astral.sh/uv/
"""
type Uv {
  """
  Files whose presence makes a directory a uv project.

  uv reads PEP 621 metadata, so a pyproject.toml is the whole list. A
  requirements.txt directory has no declarative metadata and neither `uv lock`
  nor `uv build` applies to it.
  """
  let markers: [String!]! = ["pyproject.toml"]

  """
  Python version used for the default base image. Null when a custom base is set.
  """
  version: String {
    lib.version
  }

  """
  Project roots to lock ("!" excludes; see the `lock` constructor argument).
  """
  lock: [String!]! = ["**"]

  """
  Project roots to audit ("!" excludes; see the `lock` constructor argument).
  """
  audit: [String!]! = ["**"]

  let pythonVersion: String
  let base: Container

  new(
    """
    Python version used for the default base image. Mutually exclusive with base.
    """
    version: String = null,
    """
    Base image for every uv container. Expected to provide a Python interpreter
    and uv on PATH. Mutually exclusive with version.
    """
    base: Container = null,
    """
    Project roots to lock. A bare pattern selects, a "!"-prefixed pattern
    excludes, and an exclude always wins whatever the order, so ["**", "!docs"]
    locks everything but docs.
    """
    lock: [String!]! = ["**"],
    """
    Project roots to audit. Same selection rules as `lock`.
    """
    audit: [String!]! = ["**"],
  ) {
    self.pythonVersion = version
    self.base = base
    self.lock = lock
    self.audit = audit
    self
  }

  let lib: Pyproject! {
    pyproject(markers: markers, version: pythonVersion, base: base)
  }

  """
  Python projects at or below the working directory, plus the one enclosing
  it, that have a uv.lock, keyed by project root.

  A project without a lockfile is left alone: nothing here pushes a project
  into adopting uv locking that has not asked for it.
  """
  projects(ws: Workspace!, includeSkipped: Boolean! = true): UvProjects! {
    UvProjects(
      paths: lib
        .rootsWith(ws, "uv.lock")
        .map { root => uvProject(root) }.{{path, skipLock, skipAudit}}
        .filter { project =>
          includeSkipped or project.skipLock == false or project.skipAudit == false
        }
        .map { project => project.path },
      tool: self,
    )
  }

  """
  The uv project containing a workspace path.
  """
  project(ws: Workspace!, path: String!, findUp: Boolean! = true): UvProject! {
    uvProject(lib.project(ws, path, findUp: findUp).path)
  }

  let uvProject(root: String!): UvProject! {
    UvProject(path: root, tool: self)
  }

  """
  One changeset over refreshing the uv.lock of the projects at `roots`, rooted
  at the workspace cwd where the CLI applies it.
  """
  let lockChanges(ws: Workspace!, roots: [String!]!): Changeset! {
    # Snapshot each project through the same source boundary its lock container
    # gets, so a lockfile that is already current reads as part of the baseline
    # instead of as a newly added file.
    # A project enclosing the cwd contributes only the part below the cwd,
    # which is all a changeset applied there can hold. Its uv.lock sits above
    # the cwd, so run `dagger generate` from the project root to refresh it.
    let before = roots.reduce(directory) { before, root =>
      let project = lib.at(root)
      let sub = project.cwdSubpath(ws)
      before.withDirectory(
        project.cwdPath(ws),
        project.source(ws).directory(if (sub == ".") { root } else {
          project.subpath(sub)
        }),
      )
    }
    roots
      .reduce(before) { after, root =>
        let project = lib.at(root)
        after.withDirectory(
          project.cwdPath(ws),
          uvProject(root).lockExec(ws).directory(project.cwdSubpath(ws)),
        )
      }
      .changes(before)
  }
}

# Keep all Dang types in one source file until Dagger can convert Workspace
# arguments for installed multi-file Dang modules. See dagger/dagger#13476.

"""
Python projects in a workspace that have a uv.lock, keyed by project root.
"""
type UvProjects @collection {
  """
  Project root paths.
  """
  paths: [String!]! @keys

  let tool: Uv!

  """
  The uv project rooted at path.
  """
  project(path: String!): UvProject! @get {
    tool.uvProject(path)
  }

  """
  Audit the selected projects' dependencies for known vulnerabilities.
  """
  audit(ws: Workspace!): Void @check {
    # A selection over a list evaluates its elements concurrently, so every
    # project is audited in parallel and every failure is reported.
    let failures = paths.map { p => project(p) }.{{path, failure: auditFailure(ws)}}
      .filter { result => result.failure != null }
    if (failures.length > 0) {
      raise "uv audit failed:\n" + failures.map { result =>
        "- " + result.path + ": " + (result.failure ?? "")
      }.join("\n")
    }
    null
  }

  """
  Refresh the selected projects' uv.lock.
  """
  lock(ws: Workspace!): Changeset! @generate {
    let roots = paths.map { p => project(p) }.{{path, skipLock, locked: hasLockfile(ws)}}
      .filter { p => p.skipLock == false and p.locked }
      .map { p => p.path }
    tool.lockChanges(ws, roots)
  }

  """
  Build the selected projects' wheels and sdists, each under its project root.
  """
  build(ws: Workspace!): Directory! {
    paths.reduce(directory) { dist, p =>
      dist.withDirectory(p, project(p).build(ws))
    }
  }
}

"""
A Python project rooted at a workspace-relative path.
"""
type UvProject {
  """
  Project root, relative to the workspace.
  """
  path: String!

  let tool: Uv!

  """
  Whether this project is outside the configured lock selection.
  """
  skipLock: Boolean! {
    tool.lib.at(path).selected(tool.lock) == false
  }

  """
  Whether this project is outside the configured audit selection.
  """
  skipAudit: Boolean! {
    tool.lib.at(path).selected(tool.audit) == false
  }

  """
  Whether this project has a uv.lock.
  """
  hasLockfile(ws: Workspace!): Boolean! {
    tool.lib.at(path).hasFile(ws, "uv.lock")
  }

  """
  Audit this project's dependencies for known vulnerabilities.
  """
  audit(ws: Workspace!): Void @check {
    let failure = auditFailure(ws)
    if (failure != null) {
      raise "uv audit failed in " + path + ": " + failure
    }
    null
  }

  """
  Error message from auditing this project, or null when it passes or is
  outside the configured audit selection.
  """
  let auditFailure(ws: Workspace!): String {
    if (skipAudit) {
      null
    } else {
      { auditExec(ws).sync; null } rescue {
        err: Error => err.message
      }
    }
  }

  """
  Refresh this project's uv.lock.
  """
  lock(ws: Workspace!): Changeset! @generate {
    if (skipLock or hasLockfile(ws) == false) {
      directory.changes(directory)
    } else {
      tool.lockChanges(ws, [path])
    }
  }

  """
  Build this project's wheel and sdist, and return the dist directory.
  """
  build(ws: Workspace!): Directory! {
    tool.lib.at(path).container(ws).withExec(["uv", "build"]).directory("dist")
  }

  let lockExec(ws: Workspace!): Container! {
    tool.lib.at(path).container(ws).withExec(["uv", "lock"])
  }

  let auditExec(ws: Workspace!): Container! {
    tool.lib.at(path).container(ws).withExec(["uv", "audit"])
  }
}
