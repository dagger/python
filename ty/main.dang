pub description = "Static type checking for Python projects, powered by ty"

"""
ty over every Python project in a workspace.

ty runs inside the project's environment on purpose. Without the installed
packages it cannot resolve third-party imports, and an unresolved import is
reported as an error that is not real.

ty is Astral's checker and is still before 1.0. It is its own module rather
than a setting on the mypy one because the two spell the same flag in different
languages: mypy's --exclude takes a regular expression and ty's takes a glob,
so a directory named "sdk-v1.2" needs two different escapes.

https://dagger.io
https://docs.astral.sh/ty/
"""
type Ty {
  """
  Files whose presence makes a directory a project ty should check.
  """
  let markers: [String!]! = ["pyproject.toml"]

  """
  Python version used for the default base image. Null when a custom base is set.
  """
  version: String {
    lib.version
  }

  """
  Project roots to check ("!" excludes; see the `scope` constructor argument).
  """
  scope: [String!]! = ["**"]

  """
  ty version used for a project that pins none of its own.

  Pinned rather than floating: `uv run --with ty` resolves to whichever ty is
  newest on the day it runs, which matters more here than for a stable tool
  because ty is still before 1.0 and its diagnostics still move.
  """
  defaultVersion: String! = "0.0.78"

  let pythonVersion: String
  let base: Container

  new(
    """
    Python version used for the default base image. Mutually exclusive with base.
    """
    version: String = null,
    """
    Base image for every ty container. Expected to provide a Python interpreter
    and uv on PATH. Mutually exclusive with version.
    """
    base: Container = null,
    """
    Project roots to check. A bare pattern selects, a "!"-prefixed pattern
    excludes, and an exclude always wins whatever the order, so ["**", "!docs"]
    checks everything but docs.
    """
    scope: [String!]! = ["**"],
    """
    ty version used for a project that pins none of its own.
    """
    defaultVersion: String! = "0.0.78",
  ) {
    self.pythonVersion = version
    self.base = base
    self.scope = scope
    self.defaultVersion = defaultVersion
    self
  }

  let lib: Pyproject! {
    pyproject(markers: markers, version: pythonVersion, base: base)
  }

  """
  Python projects at or below the working directory, plus the one enclosing
  it, that hold Python source of their own, keyed by project root.
  """
  projects(ws: Workspace!, includeSkipped: Boolean! = true): TyProjects! {
    TyProjects(
      paths: lib
        .rootsOwning(ws, ["*.py"])
        .map { root => tyProject(root) }.{{path, skip}}
        .filter { project => includeSkipped or project.skip == false }
        .map { project => project.path },
      tool: self,
    )
  }

  """
  The ty project containing a workspace path.
  """
  project(ws: Workspace!, path: String!, findUp: Boolean! = true): TyProject! {
    tyProject(lib.project(ws, path, findUp: findUp).path)
  }

  let tyProject(root: String!): TyProject! {
    TyProject(path: root, tool: self)
  }

  """
  The ty version used for a project: what it pins, else the default.
  """
  versionFor(ws: Workspace!, path: String!): String! {
    lib.project(ws, path).toolVersion(ws, "ty") ?? defaultVersion
  }
}

# Keep all Dang types in one source file until Dagger can convert Workspace
# arguments for installed multi-file Dang modules. See dagger/dagger#13476.

"""
Python projects in a workspace, keyed by project root.
"""
type TyProjects @collection {
  """
  Project root paths.
  """
  paths: [String!]! @keys

  let tool: Ty!

  """
  The ty project rooted at path.
  """
  project(path: String!): TyProject! @get {
    tool.tyProject(path)
  }

  """
  Type check the selected projects with ty.
  """
  typeCheck(ws: Workspace!): Void @check {
    # A selection over a list evaluates its elements concurrently, so every
    # project is checked in parallel and every failure is reported.
    let failures = paths.map { p => project(p) }.{{path, failure: typeCheckFailure(ws)}}
      .filter { result => result.failure != null }
    if (failures.length > 0) {
      raise "ty type check failed:\n" + failures.map { result =>
        "- " + result.path + ": " + (result.failure ?? "")
      }.join("\n")
    }
    null
  }
}

"""
A Python project rooted at a workspace-relative path.
"""
type TyProject {
  """
  Project root, relative to the workspace.
  """
  path: String!

  let tool: Ty!

  """
  Whether this project is outside the configured scope.
  """
  skip: Boolean! {
    tool.lib.at(path).selected(tool.scope) == false
  }

  """
  Whether this project holds Python source of its own, rather than only in a
  project nested inside it.
  """
  hasSources(ws: Workspace!): Boolean! {
    tool.lib.at(path).hasOwnFiles(ws, ["*.py"])
  }

  """
  The ty version this project is checked with: what it pins, else the
  module default.
  """
  version(ws: Workspace!): String! {
    tool.lib.at(path).toolVersion(ws, "ty") ?? tool.defaultVersion
  }

  """
  Type check this project with ty.
  """
  typeCheck(ws: Workspace!): Void @check {
    let failure = typeCheckFailure(ws)
    if (failure != null) {
      raise "ty type check failed in " + path + ": " + failure
    }
    null
  }

  """
  Error message from type checking this project, or null when it passes, is
  outside the configured scope, or holds no Python source of its own.
  """
  let typeCheckFailure(ws: Workspace!): String {
    if (skip or hasSources(ws) == false) {
      null
    } else {
      { typeCheckExec(ws).sync; null } rescue {
        err: Error => err.message
      }
    }
  }

  let typeCheckExec(ws: Workspace!): Container! {
    let project = tool.lib.at(path)
    let packages = ["ty==" + version(ws)]
    # The environment comes from the library, so the `uv sync` layer underneath
    # is the same one pytest and the other checker get.
    project
      .env(ws, with: packages)
      .withExec(["uv", "run"] + project.withFlags(packages) + ["ty", "check"]
        + project.excludeNestedFlags(ws, "--exclude", regex: false))
  }
}
