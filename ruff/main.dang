pub description = "An extremely fast Python linter and formatter, powered by ruff"

"""
ruff over every Python project in a workspace.

ruff is the one tool in this family that never touches uv. It is a standalone
binary that reaches the same verdicts with no interpreter present, so it runs
on a bare Alpine base with the pinned binary on PATH. Giving it a Python
environment would only make it slower and change nothing.

It still uses the shared library, for the parts every Python tool repeats:
finding projects, keeping nested ones apart, deciding what to mount, and
selecting a subset.

https://dagger.io
https://docs.astral.sh/ruff/
"""
type Ruff {
  """
  Files whose presence makes a directory a ruff project.

  A ruff.toml directory is a ruff project even when it holds no pyproject.toml.
  That opinion is ruff's own, which is why the library takes it as an argument
  rather than assuming it.
  """
  let markers: [String!]! = ["pyproject.toml", "ruff.toml", ".ruff.toml"]

  """
  Project roots to check ("!" excludes; see the `scope` constructor argument).
  """
  scope: [String!]! = ["**"]

  """
  Extra arguments forwarded to every ruff invocation.
  """
  args: [String!]! = []

  let container: Container

  new(
    """
    Project roots to check. A bare pattern selects, a "!"-prefixed pattern
    excludes, and an exclude always wins whatever the order, so ["**", "!docs"]
    checks everything but docs.
    """
    scope: [String!]! = ["**"],
    """
    Extra arguments forwarded to every ruff invocation.
    """
    args: [String!]! = [],
    """
    Base image for every ruff container. Expected to have ruff on PATH. No
    Python interpreter is needed or used.
    """
    container: Container = null,
  ) {
    self.scope = scope
    self.args = args
    self.container = container
    self
  }

  let lib: Pyproject! {
    pyproject(markers: markers)
  }

  """
  The pinned ruff release, extracted from the bundled Docker image so
  Dependabot can track it in ruff/images/ruff/Dockerfile.
  """
  let ruffBinary: Directory! {
    currentModule.source.directory("images/ruff").dockerBuild.rootfs
  }

  let alpine: Container! {
    currentModule.source.directory("images/alpine").dockerBuild
  }

  """
  The base every ruff command runs on: Alpine, the pinned binary, and a cache.
  """
  base: Container! {
    container ?? alpine
      .withEnvVariable("RUFF_CACHE_DIR", "/root/.cache/ruff")
      .withMountedCache("/root/.cache/ruff", cacheVolume("ruff-cache"))
      .withDirectory("/usr/local/bin", ruffBinary, include: ["ruff"])
  }

  """
  Python projects at or below the working directory, plus the one enclosing
  it, keyed by project root.
  """
  projects(ws: Workspace!, includeSkipped: Boolean! = true): RuffProjects! {
    RuffProjects(
      paths: lib
        .roots(ws)
        .map { root => ruffProject(root) }
        .filter { project => includeSkipped or project.skip == false }
        .map { project => project.path },
      tool: self,
    )
  }

  """
  The ruff project containing a workspace path.
  """
  project(ws: Workspace!, path: String!, findUp: Boolean! = true): RuffProject! {
    ruffProject(lib.project(ws, path, findUp: findUp).path)
  }

  let ruffProject(root: String!): RuffProject! {
    RuffProject(path: root, tool: self)
  }

  """
  One changeset over the projects at `roots`, after running a ruff command in
  each, rooted at the workspace cwd where the CLI applies it.
  """
  let changes(ws: Workspace!, roots: [String!]!, command: [String!]!): Changeset! {
    # Snapshot each project through the same source boundary its container
    # gets, so an unchanged file reads as part of the baseline.
    # A project enclosing the cwd contributes only the part below the cwd,
    # which is all a changeset applied there can hold.
    let before = roots.reduce(directory) { before, root =>
      let project = lib.at(root)
      let sub = project.cwdSubpath(ws)
      before.withDirectory(
        project.cwdPath(ws),
        project.source(ws).directory(if (sub == ".") { root } else {
          project.subpath(sub)
        }),
      )
    }
    roots
      .reduce(before) { after, root =>
        let project = lib.at(root)
        after.withDirectory(
          project.cwdPath(ws),
          ruffProject(root).ruffExec(ws, command).directory(
            project.cwdSubpath(ws),
          ),
        )
      }
      .changes(before)
  }

  """
  The version of the bundled ruff binary.
  """
  version: String! {
    base.withExec(["ruff", "--version"]).stdout
  }
}

# Keep all Dang types in one source file until Dagger can convert Workspace
# arguments for installed multi-file Dang modules. See dagger/dagger#13476.

"""
Python projects in a workspace, keyed by project root.
"""
type RuffProjects @collection {
  """
  Project root paths.
  """
  paths: [String!]! @keys

  let tool: Ruff!

  """
  The ruff project rooted at path.
  """
  project(path: String!): RuffProject! @get {
    tool.ruffProject(path)
  }

  """
  Lint the selected projects with ruff.
  """
  lint(ws: Workspace!): Void @check {
    # A selection over a list evaluates its elements concurrently, so every
    # project is linted in parallel and every failure is reported.
    let failures = paths.map { p => project(p) }.{{path, failure: lintFailure(ws)}}
      .filter { result => result.failure != null }
    if (failures.length > 0) {
      raise "ruff lint failed:\n" + failures.map { result =>
        "- " + result.path + ": " + (result.failure ?? "")
      }.join("\n")
    }
    null
  }

  """
  Format the selected projects with ruff.
  """
  format(ws: Workspace!): Changeset! @generate {
    let roots = paths.map { p => project(p) }.filter { p => p.skip == false }.map { p => p.path }
    tool.changes(ws, roots, ["format"])
  }

  """
  Apply ruff's automatic lint fixes to the selected projects.
  """
  fix(ws: Workspace!): Changeset! {
    let roots = paths.map { p => project(p) }.filter { p => p.skip == false }.map { p => p.path }
    tool.changes(ws, roots, ["check", "--fix", "--exit-zero"])
  }
}

"""
A Python project rooted at a workspace-relative path.
"""
type RuffProject {
  """
  Project root, relative to the workspace.
  """
  path: String!

  let tool: Ruff!

  """
  Whether this project is outside the configured scope.
  """
  skip: Boolean! {
    tool.lib.at(path).selected(tool.scope) == false
  }

  """
  Lint this project with ruff.
  """
  lint(ws: Workspace!): Void @check {
    let failure = lintFailure(ws)
    if (failure != null) {
      raise "ruff lint failed in " + path + ": " + failure
    }
    null
  }

  """
  Error message from linting this project, or null when it passes or is
  outside the configured scope.
  """
  let lintFailure(ws: Workspace!): String {
    if (skip) {
      null
    } else {
      { lintExec(ws).sync; null } rescue {
        err: Error => err.message
      }
    }
  }

  """
  Format this project with ruff.
  """
  format(ws: Workspace!): Changeset! @generate {
    if (skip) { directory.changes(directory) } else {
      tool.changes(ws, [path], ["format"])
    }
  }

  """
  Apply ruff's automatic lint fixes to this project.

  Uses --exit-zero, so a violation ruff cannot fix does not fail the call. A
  real tool error, such as a broken config, still does.
  """
  fix(ws: Workspace!): Changeset! {
    if (skip) { directory.changes(directory) } else {
      tool.changes(ws, [path], ["check", "--fix", "--exit-zero"])
    }
  }

  """
  A nested project is discovered and linted on its own, with its own config, so
  its parent must leave it alone.
  """
  let excludeNested(ws: Workspace!): [String!]! {
    tool.lib.at(path).excludeNestedFlags(ws, "--exclude", regex: false)
  }

  let workContainer(ws: Workspace!): Container! {
    tool
      .base
      .withWorkdir("/ws")
      .withDirectory(".", tool.lib.at(path).source(ws))
      .withWorkdir(path)
  }

  let ruffExec(ws: Workspace!, command: [String!]!): Container! {
    workContainer(ws).withExec(["ruff"] + command + tool.args + excludeNested(ws))
  }

  let lintExec(ws: Workspace!): Container! { ruffExec(ws, ["check"]) }
}
